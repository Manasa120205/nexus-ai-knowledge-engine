# ==============================================================================
# NEXUS — AI Knowledge Retrieval & Research Engine
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development               # development | production | test
DEBUG=false
PROJECT_NAME="NEXUS — AI Knowledge Retrieval & Research Engine"
VERSION=1.0.0
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# IMPORTANT: Generate a secure 64-character random string for production deployments
# e.g., openssl rand -hex 32
JWT_SECRET=nexus-dev-super-secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080     # 7 days (60 * 24 * 7)

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite (Zero setup, offline local default):
DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# PostgreSQL with pgvector (Production Docker / Cloud):
# DATABASE_URL=postgresql+asyncpg://nexus:nexus_secret_password@localhost:5432/nexus
USE_PGVECTOR=false                    # Set true when pgvector extension is active in PostgreSQL

# ------------------------------------------------------------------------------
# 4. CACHE & REDIS CONFIGURATION
# ------------------------------------------------------------------------------
# If Redis is unavailable, NEXUS gracefully falls back to an in-memory TTL cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600                # 1 hour default TTL
CACHE_ENABLED=true

# ------------------------------------------------------------------------------
# 5. AI PROVIDER CONFIGURATION (EMBEDDINGS & GENERATION)
# ------------------------------------------------------------------------------
# Provider options: "local" (Deterministic offline, zero cost) | "gemini"
EMBEDDING_PROVIDER=local
LLM_PROVIDER=local

# Google Gemini API Key (Required only if EMBEDDING_PROVIDER=gemini or LLM_PROVIDER=gemini)
# GEMINI_API_KEY=AIzaSy...
# EMBEDDING_API_KEY=AIzaSy...
# LLM_API_KEY=AIzaSy...

EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=384
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ------------------------------------------------------------------------------
# 6. RETRIEVAL & RANKING HYPERPARAMETERS
# ------------------------------------------------------------------------------
TOP_K_VECTOR=15                       # Candidates retrieved from dense vector search
TOP_K_KEYWORD=15                      # Candidates retrieved from BM25 inverted index
TOP_K_FINAL=5                         # Top candidates returned to user/LLM context
RRF_K=60                              # Reciprocal Rank Fusion smoothing constant

# Multi-Factor Re-Ranking Weights (Must sum to ~1.0)
RANKING_WEIGHT_SEMANTIC=0.40          # Dense semantic cosine similarity weight
RANKING_WEIGHT_KEYWORD=0.35           # Sparse BM25 keyword score weight
RANKING_WEIGHT_TITLE=0.15             # Title match bonus weight
RANKING_WEIGHT_METADATA=0.10          # Document authority/metadata weight
RANKING_FRESHNESS_DECAY=0.05          # Time decay rate per year (λ)
RANKING_DUPLICATE_PENALTY=0.15        # Penalty factor for adjacent chunks from same doc

# ------------------------------------------------------------------------------
# 7. INGESTION & CHUNKER SETTINGS
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=26214400        # 25 MB
CHUNK_SIZE_TOKENS=500                 # Target chunk size in tokens
CHUNK_OVERLAP_TOKENS=50               # Target overlap between adjacent chunks

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & SECURITY
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
