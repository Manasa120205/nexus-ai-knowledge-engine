{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/**,nexus.db,frontend/dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/index.py?__route=api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py?__route=api/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__route=health"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__route=docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__route=openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
